---
// Date-based schedule board, adapted from the UI kit's calendar fragment
// (public/assets/ui/calendar): a month grid with the campaign window and task dots,
// plus the same tasks listed by their real dates. Filled by scripts/schedule.ts.
---
<div class="sched-board" data-sched>
  <div class="sched-board__cal">
    <div class="sched-board__head">
      <b data-sched-month>—</b>
      <span class="sched-board__nav">
        <button type="button" data-sched-prev aria-label="上个月">‹</button>
        <button type="button" data-sched-next aria-label="下个月">›</button>
      </span>
    </div>
    <div class="sched-board__dow" aria-hidden="true">
      <span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span>
    </div>
    <div class="sched-board__days" data-sched-days role="group" aria-label="排期日历"></div>
    <div class="sched-board__legend">
      <span><i class="sched-board__dot" data-kind="live"></i>投放期</span>
      <span><i class="sched-board__dot"></i>阶段节点</span>
      <span><i class="sched-board__dot" data-kind="install"></i>安装批次</span>
    </div>
  </div>

  <div class="sched-board__agenda">
    <div class="sched-board__agendahead">
      <span>按日期排任务</span>
      <span class="chip chip--quiet mono" data-sched-count>—</span>
    </div>
    <div class="sched-board__list" data-sched-list></div>
  </div>
</div>

<style is:global>
  .sched-board { display: grid; grid-template-columns: 340px minmax(0, 1fr); align-items: start; gap: 24px; padding: 24px 32px 32px; }
  .sched-board__cal { padding: 20px; border-radius: 20px; background: var(--color-base); box-shadow: var(--neu-recessed-sm); }
  .sched-board__head { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
  .sched-board__head b { font: 600 15px/1.3 var(--font-sans); color: var(--ink); }
  .sched-board__nav { display: flex; gap: 8px; margin-left: auto; }
  .sched-board__nav button {
    appearance: none; width: 30px; height: 30px; border-radius: 10px;
    border: 0; background: var(--color-base); color: var(--ink);
    box-shadow: var(--neu-raised-sm);
    font: 500 14px/1 var(--font-sans); cursor: pointer;
    transition: box-shadow 200ms ease-out;
  }
  .sched-board__nav button:disabled { opacity: 0.35; cursor: default; box-shadow: none; }
  .sched-board__nav button:hover:not(:disabled) { color: var(--color-blurple); box-shadow: 2px 2px 5px #b8bcc2, -2px -2px 5px #ffffff; }
  .sched-board__nav button:active:not(:disabled) { box-shadow: var(--neu-recessed-sm); }

  .sched-board__dow, .sched-board__days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .sched-board__dow { margin-bottom: 6px; }
  .sched-board__dow span { text-align: center; font-size: 12px; line-height: 20px; color: var(--muted); }
  .sched-board__days { gap: 4px 0; }

  .sched-board__cell {
    position: relative; display: grid; justify-items: center; align-items: start; height: 40px;
    padding: 3px 0 0; border: 0; border-radius: 0; background: transparent; color: var(--ink);
    font: 500 13px/1 var(--font-sans); text-align: center;
  }
  button.sched-board__cell { cursor: pointer; }
  .sched-board__cell.is-out { color: var(--faint); opacity: 0.45; }
  .sched-board__cell.is-live::before {
    content: ""; position: absolute; left: 0; right: 0; top: 3px; height: 32px;
    background: rgba(109, 93, 252, 0.12);
  }
  .sched-board__cell.is-live-start::before { left: 4px; border-radius: 999px 0 0 999px; }
  .sched-board__cell.is-live-end::before { right: 4px; border-radius: 0 999px 999px 0; }
  .sched-board__cell.is-live-start.is-live-end::before { border-radius: 999px; }

  .sched-board__num {
    position: relative; z-index: 1; display: grid; place-items: center;
    width: 28px; height: 28px; border-radius: 50%; font-variant-numeric: tabular-nums;
  }
  .sched-board__cell.is-has .sched-board__num { background: var(--color-base); box-shadow: var(--neu-raised-sm); font-weight: 600; color: var(--ink); }
  .sched-board__cell.is-sel .sched-board__num { background: var(--color-blurple); color: #ffffff; box-shadow: none; font-weight: 600; }
  .sched-board__cell:focus-visible .sched-board__num { outline: 2px solid var(--color-blurple); outline-offset: 2px; }

  .sched-board__dots { position: absolute; z-index: 1; left: 0; right: 0; bottom: 1px; display: flex; justify-content: center; gap: 3px; }
  .sched-board__dots i { width: 4px; height: 4px; border-radius: 50%; background: var(--color-blurple); }
  .sched-board__dots i[data-kind="install"] { background: var(--color-mint-ink); }

  .sched-board__legend {
    display: flex; flex-wrap: wrap; gap: 12px; margin-top: 14px; padding-top: 12px;
    font-size: 12px; color: var(--muted);
  }
  .sched-board__legend span { display: inline-flex; align-items: center; gap: 5px; }
  .sched-board__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-blurple); }
  .sched-board__dot[data-kind="live"] { width: 12px; height: 8px; border-radius: 3px; background: rgba(109, 93, 252, 0.25); }
  .sched-board__dot[data-kind="install"] { background: var(--color-mint-ink); }

  .sched-board__agenda { padding: 4px 0; min-width: 0; }
  .sched-board__agendahead { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; font-size: 14px; font-weight: 500; color: var(--ink); }
  .sched-board__agendahead .chip { margin-left: auto; }
  .sched-board__list { display: grid; gap: 10px; }

  .sched-board__month {
    display: flex; align-items: baseline; gap: 8px; padding: 6px 4px;
    font-size: 12px; font-weight: 600; color: var(--muted); letter-spacing: 0.04em;
  }
  .sched-board__month:not(:first-child) { margin-top: 12px; }
  .sched-board__month small { font-weight: 400; color: var(--faint); }

  .sched-board__row {
    display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 14px;
    padding: 12px 14px; border-radius: 16px; background: var(--color-base);
    box-shadow: var(--neu-raised-sm); transition: box-shadow 200ms ease-out;
  }
  .sched-board__row.is-focus { box-shadow: var(--neu-recessed-sm); }
  .sched-board__tile {
    display: grid; place-items: center; align-content: center; width: 46px; height: 46px;
    border-radius: 14px; background: var(--color-base); box-shadow: var(--neu-recessed-sm);
  }
  .sched-board__tile b { font: 600 16px/1 var(--font-sans); font-variant-numeric: tabular-nums; color: var(--ink); }
  .sched-board__tile i { font: 400 10px/1.3 var(--font-sans); font-style: normal; color: var(--muted); white-space: nowrap; }
  .sched-board__tile.is-key { background: var(--color-blurple); box-shadow: none; }
  .sched-board__tile.is-key :is(b, i) { color: #ffffff; }

  .sched-board__tasks { display: grid; gap: 6px; min-width: 0; }
  .sched-board__task { padding-left: 10px; border-left: 2px solid rgba(109, 93, 252, 0.45); }
  .sched-board__task[data-kind="install"] { border-left-color: var(--color-mint-ink); }
  .sched-board__taskline { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .sched-board__taskline b { font: 500 14px/1.35 var(--font-sans); color: var(--ink); }
  .sched-board__taskline .chip { padding: 3px 8px; font-size: 11px; }
  .sched-board__task small { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; line-height: 1.5; }
  .sched-board__empty { padding: 24px; color: var(--muted); font-size: 14px; }

  @media (max-width: 980px) {
    .sched-board { grid-template-columns: 1fr; }
  }
</style>
