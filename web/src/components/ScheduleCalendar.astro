---
// Date-based schedule board, adapted from the UI kit's calendar fragment
// (public/assets/ui/calendar): a month grid with the campaign window and task dots,
// plus the same tasks listed by their real dates. Filled by scripts/schedule.ts.
---
<div class="sched-board" data-sched>
  <div class="sched-board__cal">
    <div class="sched-board__head">
      <b data-sched-month>—</b>
      <span class="sched-board__nav">
        <button type="button" data-sched-prev aria-label="上个月">‹</button>
        <button type="button" data-sched-next aria-label="下个月">›</button>
      </span>
    </div>
    <div class="sched-board__dow" aria-hidden="true">
      <span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span><span>日</span>
    </div>
    <div class="sched-board__days" data-sched-days role="group" aria-label="排期日历"></div>
    <div class="sched-board__legend">
      <span><i class="sched-board__dot" data-kind="live"></i>投放期</span>
      <span><i class="sched-board__dot"></i>阶段节点</span>
      <span><i class="sched-board__dot" data-kind="install"></i>安装批次</span>
    </div>
  </div>

  <div class="sched-board__agenda">
    <div class="sched-board__agendahead">
      <span>按日期排任务</span>
      <span class="chip chip--quiet mono" data-sched-count>—</span>
    </div>
    <div class="sched-board__list" data-sched-list></div>
  </div>
</div>

<style is:global>
  .sched-board { display: grid; grid-template-columns: 340px minmax(0, 1fr); align-items: start; }
  .sched-board__cal { padding: var(--s-4); border-right: 1px solid var(--line); }
  .sched-board__head { display: flex; align-items: center; gap: var(--s-2); margin-bottom: var(--s-2); }
  .sched-board__head b { font: 500 15px/1.3 var(--font-display); letter-spacing: -0.01em; }
  .sched-board__nav { display: flex; gap: 4px; margin-left: auto; }
  .sched-board__nav button {
    appearance: none; width: 28px; height: 28px; border-radius: var(--r-sm);
    border: 1px solid var(--line); background: transparent; color: var(--ink);
    font: 500 14px/1 var(--font-text); cursor: pointer;
  }
  .sched-board__nav button:disabled { opacity: 0.35; cursor: default; }
  .sched-board__nav button:hover:not(:disabled) { border-color: var(--line-strong); }

  .sched-board__dow, .sched-board__days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
  .sched-board__dow { margin-bottom: 4px; }
  .sched-board__dow span { text-align: center; font-size: 12px; line-height: 20px; color: var(--muted); }
  .sched-board__days { gap: 2px 0; }

  .sched-board__cell {
    position: relative; display: grid; justify-items: center; align-items: start; height: 40px;
    padding: 3px 0 0; border: 0; border-radius: 0; background: transparent; color: var(--ink);
    font: 450 13px/1 var(--font-text); text-align: center;
  }
  button.sched-board__cell { cursor: pointer; }
  .sched-board__cell.is-out { color: color-mix(in oklab, var(--ink) 30%, transparent); }
  .sched-board__cell.is-live::before {
    content: ""; position: absolute; left: 0; right: 0; top: 3px; height: 32px;
    background: color-mix(in oklab, var(--accent) 11%, transparent);
  }
  .sched-board__cell.is-live-start::before { left: 4px; border-radius: 999px 0 0 999px; }
  .sched-board__cell.is-live-end::before { right: 4px; border-radius: 0 999px 999px 0; }
  .sched-board__cell.is-live-start.is-live-end::before { border-radius: 999px; }

  .sched-board__num {
    position: relative; z-index: 1; display: grid; place-items: center;
    width: 28px; height: 28px; border-radius: 50%; font-variant-numeric: tabular-nums;
  }
  .sched-board__cell.is-has .sched-board__num { background: var(--bg); box-shadow: inset 0 0 0 1px var(--line-strong); font-weight: 600; }
  .sched-board__cell.is-sel .sched-board__num { background: var(--ink); color: var(--bg); box-shadow: none; }
  .sched-board__cell:focus-visible .sched-board__num { outline: 2px solid var(--accent); outline-offset: 2px; }

  .sched-board__dots { position: absolute; z-index: 1; left: 0; right: 0; bottom: 1px; display: flex; justify-content: center; gap: 3px; }
  .sched-board__dots i { width: 4px; height: 4px; border-radius: 50%; background: var(--ink); }
  .sched-board__dots i[data-kind="install"] { background: var(--accent); }

  .sched-board__legend {
    display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--s-3); padding-top: var(--s-3);
    border-top: 1px solid var(--line); font-size: 12px; color: var(--muted);
  }
  .sched-board__legend span { display: inline-flex; align-items: center; gap: 5px; }
  .sched-board__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ink); }
  .sched-board__dot[data-kind="live"] { width: 12px; height: 8px; border-radius: 3px; background: color-mix(in oklab, var(--accent) 22%, white); }
  .sched-board__dot[data-kind="install"] { background: var(--accent); }

  .sched-board__agenda { padding: var(--s-4); min-width: 0; }
  .sched-board__agendahead { display: flex; align-items: center; gap: 8px; margin-bottom: var(--s-3); font-size: var(--t-small); font-weight: 500; }
  .sched-board__agendahead .chip { margin-left: auto; }
  .sched-board__list { display: grid; }

  .sched-board__month {
    display: flex; align-items: baseline; gap: 8px; padding: 6px 0 8px;
    border-bottom: 1px solid var(--line-strong); font-size: 12px; font-weight: 500; color: var(--muted);
  }
  .sched-board__month:not(:first-child) { margin-top: var(--s-4); }
  .sched-board__month small { font-weight: 400; color: color-mix(in oklab, var(--muted) 80%, transparent); }

  .sched-board__row {
    display: grid; grid-template-columns: 46px minmax(0, 1fr); gap: 12px;
    padding: 10px 0; border-bottom: 1px solid var(--line); transition: background-color 260ms ease;
  }
  .sched-board__row.is-focus { background: color-mix(in oklab, var(--accent) 7%, transparent); }
  .sched-board__tile {
    display: grid; place-items: center; align-content: center; width: 46px; height: 46px;
    border-radius: var(--r-sm); background: var(--bg); box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .sched-board__tile b { font: 600 16px/1 var(--font-display); font-variant-numeric: tabular-nums; }
  .sched-board__tile i { font: 400 10px/1.3 var(--font-text); font-style: normal; color: var(--muted); white-space: nowrap; }
  .sched-board__tile.is-key { background: var(--ink); box-shadow: none; }
  .sched-board__tile.is-key :is(b, i) { color: var(--bg); }

  .sched-board__tasks { display: grid; gap: 6px; min-width: 0; }
  .sched-board__task { padding-left: 10px; border-left: 2px solid var(--line-strong); }
  .sched-board__task[data-kind="install"] { border-left-color: var(--accent); }
  .sched-board__taskline { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .sched-board__taskline b { font: 500 14px/1.35 var(--font-text); }
  .sched-board__taskline .chip { height: 20px; padding: 0 7px; font-size: 11px; }
  .sched-board__task small { display: block; margin-top: 2px; color: var(--muted); font-size: 12px; line-height: 1.45; }
  .sched-board__empty { padding: var(--s-5); color: var(--muted); font-size: 14px; }

  @media (max-width: 980px) {
    .sched-board { grid-template-columns: 1fr; }
    .sched-board__cal { border-right: 0; border-bottom: 1px solid var(--line); }
  }
</style>
