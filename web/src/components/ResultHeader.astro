---
// Shared result header: title, telemetry status strip, 4-tab switcher, and one unified
// "导出 PDF" dropdown (all 4 official Flair Media templates available from every tab without button clutter).
interface Props { active: 'overview' | 'media' | 'economics' | 'effects'; title?: string }
const { active, title = '方案结果' } = Astro.props;
const tabs: { key: string; label: string }[] = [
  { key: 'overview', label: '概览' },
  { key: 'media', label: '媒体与地图' },
  { key: 'economics', label: '报价与排期' },
  { key: 'effects', label: '效果与校验' },
];
---
<header class="result-head" aria-label="结果页头">
  <div class="wrap">
    <div class="result-head__top">
      <div class="result-head__title">
        <h1 data-result-title>{title}</h1>
      </div>

      <div class="result-head__actions">
        <a class="btn btn--ghost" href="/input.html">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M12.5 5L7.5 10L12.5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          重新配置
        </a>
      </div>
    </div>

    <div class="statusbar" data-result-status-bar>
      <div class="statusbar__top">
        <div class="statusbar__meta">
          <span>状态 <b data-run-status class="statusbar__state">—</b></span>
          <span>求解器 <b data-solver class="mono">—</b></span>
        </div>
        <div class="statusbar__periods">
          <span class="chip chip--quiet mono" data-src-inventory>红豆库存 · —</span>
          <span class="chip chip--quiet mono" data-src-bigdata>新云大数据 · —</span>
        </div>
      </div>
      <div class="statusbar__delivery" data-delivery-row hidden>
        <span class="chip chip--ok statusbar__pill" data-acquired-flag hidden></span>
        <span class="chip chip--warn statusbar__pill" data-failure-flag hidden></span>
      </div>
    </div>

    <div class="result-tabs-row">
      <nav class="result-tabs" aria-label="结果页导航">
        {tabs.map((t) => (
          <a href={`/result/${t.key}.html`} data-tab={t.key} aria-current={active === t.key ? 'page' : undefined}>{t.label}</a>
        ))}
      </nav>
      {active !== 'overview' && (
        <div class="variant-seg" data-variant-pills aria-label="切换策略方案" hidden></div>
      )}
    </div>
  </div>
</header>
<script>
  const sp = new URLSearchParams(location.search);
  const runId = sp.get('run');
  const variant = sp.get('variant');
  if (runId) {
    document.querySelectorAll<HTMLAnchorElement>('[data-tab]').forEach((a) => {
      const u = new URL(a.href, location.origin);
      u.searchParams.set('run', runId);
      if (variant) u.searchParams.set('variant', variant);
      a.href = u.toString();
    });
  }
</script>
