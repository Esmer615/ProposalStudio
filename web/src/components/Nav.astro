---
// Floating translucent frosted-glass navigation bar (Linear / Vercel style).
// Minimal links, active state indicator, conditional "最近方案" shortcut, zero redundant buttons.
interface Props { active?: string }
const { active = '' } = Astro.props;
const links = [
  { key: 'index', label: '概览', href: '/index.html' },
  { key: 'input', label: '方案工作台', href: '/input.html' },
];
---
<header class={`nav ${active === 'index' ? 'nav--hero-blend' : 'nav--dock'}`}>
  <a class="skip-link" href="#top">跳到正文</a>
  <div class="nav__frame">
    <div class="nav__bar">
      <a class="nav__logo" href="/index.html">
        <span class="nav__mark" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <defs>
              <linearGradient id="xyMarkGrad" x1="2" y1="3" x2="22" y2="21" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#6d5dfc" />
                <stop offset="100%" stop-color="#30c2b8" />
              </linearGradient>
            </defs>
            <path d="M5 15.2C5 12.6 7.1 10.6 9.8 10.6H17.5C19.2 10.6 20.5 9.2 20.5 7.5C20.5 5.8 19.2 4.5 17.5 4.5H10.6C7.5 4.5 5 7 5 10.1V19.5" stroke="url(#xyMarkGrad)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9.5 15.2H15.8" stroke="url(#xyMarkGrad)" stroke-width="2" stroke-linecap="round"/>
            <circle cx="19" cy="15.2" r="1.6" fill="url(#xyMarkGrad)"/>
          </svg>
        </span>
        <span class="nav__title">新云媒介提案台</span>
      </a>

      <span class="nav__sep" aria-hidden="true"></span>

      <nav class="nav__links" aria-label="主导航">
        {links.map((l) => (
          <a class="nav__link" href={l.href} aria-current={active === l.key ? 'page' : undefined}>
            <span>{l.label}</span>
          </a>
        ))}
        <a
          class="nav__link"
          href="/result/overview.html"
          data-recent
          aria-current={active !== 'index' && active !== 'input' ? 'page' : undefined}
          hidden
        >
          <span>最近方案</span>
        </a>
      </nav>
    </div>
  </div>
</header>
<script>
  const el = document.querySelector<HTMLAnchorElement>('[data-recent]');
  if (el) {
    const id = localStorage.getItem('lastRunId');
    if (id) {
      el.hidden = false;
      el.setAttribute('href', `/result/overview.html?run=${encodeURIComponent(id)}`);
    }
  }
</script>
