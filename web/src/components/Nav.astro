---
// App chrome nav: logo + two text links + a right-side mono label (deterministic engine).
// No mega menu, no image cards, no primary CTA button. The label anchors the right edge
// so the nav content spans the container at 80-1360px (SR-6 container-edges).
interface Props { active?: string }
const { active = '' } = Astro.props;
const links = [
  { key: 'index', label: '主页', href: '/index.html' },
  { key: 'input', label: '生成提案', href: '/input.html' },
];
---
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">跳到正文</a>
    <a class="nav__logo" href="/index.html"><span class="mark" data-mark="stack" aria-hidden="true"></span>新云媒介提案台</a>
    <nav class="nav__links" aria-label="主导航">
      {links.map((l) => (
        <div class="nav__item">
          <a class="nav__link" href={l.href} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
        </div>
      ))}
    </nav>
    <div class="nav__actions">
      <a class="nav__link" href="/result/overview.html" data-recent hidden>最近方案</a>
      <span class="nav__tag mono">确定性引擎 · 2027 可售</span>
    </div>
  </div>
</header>
<script>
  // Surface a lightweight "最近方案" text link if a last run exists (handoff: 最近方案如有).
  const el = document.querySelector('[data-recent]');
  if (el) {
    const id = localStorage.getItem('lastRunId');
    if (id) {
      el.hidden = false;
      el.setAttribute('href', `/result/overview.html?run=${encodeURIComponent(id)}`);
    }
  }
</script>
