---
import Base from '../layouts/Base.astro';
import StaticMap from '../components/StaticMap.astro';
---
<Base
  title="方案工作台 · 新云媒介提案台"
  description="输入任意上海公司/品牌/地标，与 Agent 交互确认投放细节，实时拉取红豆库存与新云大数据并生成三套差异化方案。"
  active="input"
>
<main id="top">
  <section class="input-workbench" aria-labelledby="page-h">
    <div class="wrap">
      <header class="input-header">
        <div class="input-header__copy">
          <h1 id="page-h">投放方案生成工作台</h1>
          <p>支持输入全国任意客户公司或品牌；Agent 自动调研公司地址、所属行业与广告策略并在高德地图精准定位，确认后一次生成三套策略方案。</p>
        </div>

        <!-- 精简重构：新云大数据会话实时连接状态微组件 -->
        <div class="xinyun-status-wrap">
          <button
            type="button"
            class="xinyun-pill"
            id="xinyun-status-pill"
            data-state="loading"
            aria-label="新云大数据会话连接状态，点击重新检测"
            aria-describedby="xinyun-pill-tip"
          >
            <span class="xinyun-pill__well" aria-hidden="true">
              <span class="xinyun-pill__dot"></span>
            </span>
            <span class="xinyun-pill__meta">
              <span class="xinyun-pill__lbl">新云大数据会话</span>
              <b class="xinyun-pill__val mono" data-out="xinyun-status">检测连接中…</b>
            </span>
            <span class="xinyun-pill__refresh" aria-hidden="true" title="点击刷新状态">
              <svg viewBox="0 0 16 16" fill="none">
                <path d="M13.5 8A5.5 5.5 0 1 1 11.88 4.11M13.5 2.5V5.5H10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </button>
          <div class="xinyun-pill__tip" id="xinyun-pill-tip" role="tooltip">
            新云周边覆盖、AI 线路轨迹与人群画像已接入工作流；会话有效时实时抓取，未登录时自动降级。点击可重新检测。
          </div>
        </div>
      </header>

      <!-- 2+1 非对称空间 Bento 工作台：上排左表单 + 右等高地图，下排两列通栏 Agent 对话台 -->
      <div class="workbench-bento">
        <!-- Bento Tile 1：投放需求与目标定位（紧凑两列节奏） -->
        <div class="card bento-form-card">
          <div class="card-head">
            <span>投放需求与目标定位</span>
            <span class="chip chip--accent mono">一次输出 3 套策略</span>
          </div>
          <div class="card-body">
            <div id="plan-form" class="form workbench-form">
              <!-- 自由输入全国客户公司/品牌 + 聚焦展开快捷示例 -->
              <div class="field field--full">
                <label for="f-venue-query">
                  <span>客户公司 / 品牌名称</span>
                </label>
                <div class="venue-combobox" id="venue-combobox">
                  <div class="venue-search" role="search" aria-label="输入客户公司或品牌名称">
                    <input
                      id="f-venue-query"
                      type="search"
                      autocomplete="off"
                      placeholder="输入全国任意客户公司，如：贵州老干妈、中国平安、上海乐高乐园…"
                      value="上海乐高乐园"
                      aria-expanded="false"
                      aria-controls="loc-suggest-pop"
                    />
                    <button type="button" class="btn btn--secondary" id="btn-venue-search">Agent 定位</button>
                  </div>
                  <div class="loc-suggest-pop" id="loc-suggest-pop" role="listbox" aria-label="常用示例客户">
                    <div class="loc-suggest-pop__head">
                      <span>快捷示例</span>
                      <small>可直接输入全国任意企业，由 Agent 自动查地址与行业策略</small>
                    </div>
                    <div class="loc-presets" id="loc-presets">
                      <button type="button" class="preset-pill is-active" data-loc-preset="lego_shanghai">上海乐高乐园</button>
                      <button type="button" class="preset-pill" data-loc-preset="disney_shanghai">上海迪士尼</button>
                      <button type="button" class="preset-pill" data-loc-preset="haichang_shanghai">上海海昌</button>
                      <button type="button" class="preset-pill" data-loc-preset="custom_pingan">陆家嘴·中国平安</button>
                      <button type="button" class="preset-pill" data-loc-preset="custom_jingan">静安寺商圈</button>
                      <button type="button" class="preset-pill" data-loc-preset="custom_xujiahui">徐家汇港汇</button>
                    </div>
                  </div>
                </div>
                <select id="f-venue" name="venue" hidden></select>
                <span class="faint t-xs" id="venue-search-note" hidden></span>
              </div>

              <div class="field">
                <label for="f-industry">所属行业</label>
                <select id="f-industry" name="industry">
                  <option value="乐园" selected>乐园 / 文旅目的地</option>
                  <option value="银行保险">银行保险 / 金融</option>
                  <option value="食品饮料">食品饮料 / 快消</option>
                  <option value="保健品">保健品 / 大健康</option>
                  <option value="私立医院">私立医院 / 医疗</option>
                  <option value="其他">其他商业品牌</option>
                </select>
              </div>

              <div class="field">
                <label for="f-customer">签约客户类型</label>
                <select id="f-customer" name="customer_type">
                  <option value="direct" selected>直客</option>
                  <option value="4a">4A 代理</option>
                </select>
              </div>

              <div class="field field--full">
                <label for="f-budget-num">
                  <span>投放预算（万元）</span>
                  <span class="mono gold budget-readout"><span id="budget-val">300</span> <small>万</small></span>
                </label>
                <div class="budget-inline">
                  <input type="range" id="f-budget" name="budget_wan_slider" min="100" max="500" step="10" value="300" aria-label="投放预算滑块" />
                  <div class="unit-input">
                    <input
                      id="f-budget-num"
                      name="budget_wan"
                      type="number"
                      min="10"
                      max="5000"
                      step="10"
                      value="300"
                      placeholder="预算"
                    />
                    <span class="unit-input__suffix">万</span>
                  </div>
                </div>
              </div>

              <div class="field field--full" id="f-media-group">
                <span class="field__lbl">投放媒介</span>
                <div class="check-grid">
                  <label class="check-card"><input type="checkbox" name="media" value="bus" checked /> 公交车身</label>
                  <label class="check-card"><input type="checkbox" name="media" value="metro" checked /> 地铁出入口</label>
                </div>
                <span class="field__error" data-error="media" hidden></span>
              </div>

              <div class="field">
                <label for="f-start">起始档期</label>
                <div class="unit-input unit-input--picker" id="start-month-wrap">
                  <input
                    id="f-start"
                    name="start_date"
                    type="text"
                    value="2027.01"
                    placeholder="选择年月"
                    readonly
                    autocomplete="off"
                    aria-label="选择起始档期月份"
                  />
                  <button type="button" class="unit-input__trigger" id="btn-start-picker" aria-label="打开月份选择器" tabindex="-1">
                    <span class="unit-input__suffix">月</span>
                    <svg class="unit-input__cal" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                      <rect x="2.25" y="3.5" width="13.5" height="12" rx="3" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M5.75 2V4.75M12.25 2V4.75M2.25 7.5H15.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="field">
                <label for="f-weeks">投放周数</label>
                <div class="unit-input">
                  <input
                    id="f-weeks"
                    name="weeks"
                    type="number"
                    min="2"
                    max="52"
                    step="1"
                    value="8"
                    placeholder="最小 2"
                  />
                  <span class="unit-input__suffix">周</span>
                </div>
              </div>

              <details class="field field--full">
                <summary>高级点位锁定与排除（可选）</summary>
                <div class="lock-grid">
                  <div class="field">
                    <label for="f-lock-include">锁定必选点位</label>
                    <input id="f-lock-include" type="text" name="lock_include" placeholder="例：metro:人民广场:14号口" />
                  </div>
                  <div class="field">
                    <label for="f-lock-exclude">排除点位</label>
                    <input id="f-lock-exclude" type="text" name="lock_exclude" placeholder="例：bus:17:大三侧" />
                  </div>
                </div>
              </details>

              <div class="field field--full">
                <div class="input-submit input-submit--tight">
                  <button type="button" class="btn btn--primary btn--lg" id="btn-generate" style="flex:1">
                    启动 Agent 生成三套方案
                    <svg class="ico-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M4.5 10H15.5M15.5 10L11 5.5M15.5 10L11 14.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
                <span class="muted t-xs" id="run-note" hidden></span>
              </div>

              <span class="field__error field--full" id="form-error" data-error="form" hidden></span>
            </div>
          </div>
        </div>

        <!-- Bento Tile 2：客户公司全国地址定位地图 -->
        <div class="card bento-map-card">
          <div class="card-head">
            <span data-out="map-card-title">客户公司地址定位</span>
            <span class="chip chip--quiet mono" data-out="map-status">加载中</span>
          </div>
          <div class="map-frame bento-map-frame" id="input-map" data-default-venue="lego_shanghai" data-mode="fallback">
            <div id="amap"></div>
            <div class="map-fallback">
              <StaticMap showPois labels />
            </div>
            <div class="map-note" data-map-note>客户位置预览</div>
            <div class="map-legend">
              <span><i class="accent"></i>客户公司地址</span>
              <span><i class="cand"></i>备选分支地址</span>
            </div>
          </div>
        </div>

        <!-- Bento Tile 3：两列通栏宽幅交互式 Agent 策略顾问 -->
        <div class="card pipeline-card bento-copilot-card" id="pipeline-card">
          <div class="copilot-head">
            <div class="copilot-head__left">
              <span class="copilot-orb" aria-hidden="true"></span>
              <div class="copilot-head__titles">
                <div class="stage-live" data-out="stage-live">Agent 顾问在线 · 可先对话确认客户信息与策略</div>
                <span class="copilot-head__sub">输入全国任意客户公司，Agent 自动查找地址、研判行业与广告策略并交由您确认</span>
              </div>
            </div>
            <div class="copilot-head__right">
              <button type="button" class="btn btn--ghost btn--xs" id="btn-reopen-progress" hidden>查看生成进度</button>
              <span class="chip chip--accent mono">AI 需求沟通</span>
            </div>
          </div>

          <div class="dialog copilot-dialog" id="agent-dialog" role="log" aria-live="polite" aria-label="Agent 交流">
            <div class="msg msg--agent">
              <div class="msg__head">FLAIR AGENT · 客户调研与策略顾问</div>
              您好！请告诉我本次服务的客户公司名称与大致预算（支持全国各地企业，不限上海）。我会自动核实企业全称、在高德地图定位公司真实地址，并为您梳理所属行业与户外广告策略建议，经您确认后一键生成三套方案。
              <div class="agent-chips">
                <button type="button" class="q-chip" data-consult-quick="我是贵州老干妈，预算350万投8周">试试：贵州老干妈 · 350万</button>
                <button type="button" class="q-chip" data-consult-quick="我们是陆家嘴中国平安，预算300万投8周，优先核心地标聚焦">试试：陆家嘴中国平安 · 300万</button>
                <button type="button" class="q-chip" data-consult-quick="上海乐高乐园暑期500万，公交加地铁组合，直客签约">试试：乐高乐园暑期 · 500万</button>
              </div>
            </div>
          </div>

          <div class="agent-composer copilot-composer">
            <input id="agent-chat-input" type="text" autocomplete="off" placeholder="输入客户公司与需求，如：我是贵州老干妈，预算 350 万；或：我们是深圳比亚迪…" />
            <button type="button" class="btn btn--primary" id="btn-agent-send">
              <span>发送</span>
              <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M3.5 9H14.5M14.5 9L9.8 4.3M14.5 9L9.8 13.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- 点击“启动 Agent 生成三套方案”后弹出的 8 阶段实时进度弹窗（置于 main 外部以确保全屏遮罩层级） -->
<div class="run-modal__scrim" id="run-modal-scrim" data-open="false" aria-hidden="true"></div>
<div
  class="run-modal"
  id="run-progress-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="run-modal-title"
  data-open="false"
  data-status="running"
>
  <div class="run-modal__head">
    <div class="run-modal__title-wrap">
      <span class="run-modal__orb" aria-hidden="true"></span>
      <div>
        <h2 class="run-modal__title" id="run-modal-title" data-out="modal-stage-live">正在启动 Agent 管线…</h2>
        <p class="run-modal__summary mono" data-out="modal-target-summary">—</p>
      </div>
    </div>
    <div class="run-modal__head-right">
      <span class="chip chip--accent mono" data-out="modal-elapsed">0s</span>
      <button type="button" class="run-modal__close" id="btn-close-run-modal" aria-label="收起进度弹窗" title="收起至后台">
        <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M4.5 4.5L13.5 13.5M13.5 4.5L4.5 13.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="stages input-stages run-modal__stages" id="run-stages" aria-label="运行阶段">
    <div class="stage" data-stage="intake" data-state="pending"><b>解析</b></div>
    <div class="stage" data-stage="data_inventory" data-state="pending"><b>红豆</b></div>
    <div class="stage" data-stage="data_bigdata" data-state="pending"><b>新云</b></div>
    <div class="stage" data-stage="engine" data-state="pending"><b>三方案</b></div>
    <div class="stage" data-stage="data_routes" data-state="pending"><b>轨迹画像</b></div>
    <div class="stage" data-stage="visualize" data-state="pending"><b>热力图</b></div>
    <div class="stage" data-stage="narrative" data-state="pending"><b>话术</b></div>
    <div class="stage" data-stage="done" data-state="pending"><b>完成</b></div>
  </div>

  <div class="run-modal__status-bar">
    <span class="run-modal__note" data-out="modal-note">已提交：实时红豆库存 + 新云周边覆盖/画像 + 三套确定性策略方案求解中…</span>
    <button type="button" class="btn btn--secondary btn--sm" id="btn-modal-dismiss" hidden>返回修改参数</button>
  </div>
</div>
</Base>
<script>
  import '../scripts/input';

  // Wire budget preset pills cleanly to #f-budget range slider
  const budgetInput = document.getElementById('f-budget') as HTMLInputElement | null;
  const budgetVal = document.getElementById('budget-val');
  const presets = [...document.querySelectorAll<HTMLButtonElement>('[data-budget-preset]')];
  function syncPresets() {
    if (!budgetInput) return;
    const cur = String(budgetInput.value);
    presets.forEach((b) => b.classList.toggle('is-active', b.dataset.budgetPreset === cur));
  }
  presets.forEach((b) => {
    b.addEventListener('click', () => {
      if (!budgetInput) return;
      budgetInput.value = b.dataset.budgetPreset || '300';
      if (budgetVal) budgetVal.textContent = budgetInput.value;
      budgetInput.dispatchEvent(new Event('input', { bubbles: true }));
      budgetInput.dispatchEvent(new Event('change', { bubbles: true }));
      syncPresets();
    });
  });
  budgetInput?.addEventListener('input', syncPresets);
</script>
