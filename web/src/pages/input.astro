---
import Base from '../layouts/Base.astro';
import StaticMap from '../components/StaticMap.astro';
---
<Base
  title="方案工作台 · 新云媒介提案台"
  description="配置场馆、预算、媒介、档期与客户类型，Agent 实时拉取红豆与新云数据并运行确定性引擎。"
  active="input"
>
<main id="top">
  <section class="input-workbench" aria-labelledby="page-h">
    <div class="wrap">
      <header class="input-header">
        <div>
          <h1 id="page-h">投放方案生成工作台</h1>
          <p>配置目标场馆、预算与档期（可补充一句话 brief），启动 Agent 实时取数并由 CP-SAT 引擎求解。</p>
        </div>
        <span class="chip chip--quiet mono" data-out="intro-fact">正在连接本地引擎…</span>
      </header>

      <div class="input-split">
        <!-- 左栏：配置表单 + Agent 日志 + 8 阶段进度 -->
        <div class="input-split__main">
          <div class="card">
            <div class="card-head">
              <span>需求配置</span>
              <span class="chip chip--accent mono">确定性求解</span>
            </div>
            <div class="card-body">
              <div id="plan-form" class="form" style="grid-template-columns:1fr 1fr">
                <div class="field field--full">
                  <label for="f-venue">目标场馆</label>
                  <select id="f-venue" name="venue"></select>
                  <div class="venue-search" role="search" aria-label="自定义地点查询">
                    <input id="f-venue-query" type="search" autocomplete="off" placeholder="或输入上海任意地标检索，如：上海天文馆" />
                    <button type="button" class="btn btn--secondary" id="btn-venue-search">定位</button>
                  </div>
                  <span class="faint t-xs" id="venue-search-note" hidden></span>
                </div>

                <div class="field field--full">
                  <label for="f-budget">
                    <span>投放预算（万元）</span>
                    <span class="mono gold" style="font-size:20px;font-weight:600"><span id="budget-val">500</span> <small style="font-size:12px;color:var(--muted);font-weight:400">万</small></span>
                  </label>
                  <input type="range" id="f-budget" name="budget_wan" min="100" max="500" step="10" value="500" />
                  <div class="preset-row" aria-label="常用预算档位">
                    <button type="button" class="preset-pill" data-budget-preset="100">100 万</button>
                    <button type="button" class="preset-pill" data-budget-preset="200">200 万</button>
                    <button type="button" class="preset-pill is-active" data-budget-preset="500">500 万</button>
                  </div>
                </div>

                <div class="field field--full" id="f-media-group">
                  <span class="field__lbl">投放媒介</span>
                  <div class="check-grid">
                    <label class="check-card"><input type="checkbox" name="media" value="bus" checked /> 公交车身</label>
                    <label class="check-card"><input type="checkbox" name="media" value="metro" checked /> 地铁出入口</label>
                  </div>
                  <span class="field__error" data-error="media" hidden></span>
                </div>

                <div class="field">
                  <label for="f-start">起始档期</label>
                  <select id="f-start" name="start_date"></select>
                </div>

                <div class="field">
                  <label for="f-weeks">投放周数</label>
                  <select id="f-weeks" name="weeks">
                    <option value="2">2 周</option>
                    <option value="4">4 周</option>
                    <option value="6">6 周</option>
                    <option value="8" selected>8 周</option>
                    <option value="12">12 周</option>
                  </select>
                </div>

                <div class="field field--full">
                  <label for="f-customer">签约客户类型（自动匹配合同模板）</label>
                  <select id="f-customer" name="customer_type">
                    <option value="direct" selected>直客（匹配《直客广告发布合同》）</option>
                    <option value="4a">4A 代理（匹配《4A 排期订单》+《年度框架合同》）</option>
                  </select>
                </div>

                <details class="field field--full">
                  <summary>高级点位锁定与排除（可选）</summary>
                  <div style="display:grid;gap:12px;margin-top:12px;grid-template-columns:1fr 1fr">
                    <div class="field">
                      <label for="f-lock-include">锁定必选点位</label>
                      <input id="f-lock-include" type="text" name="lock_include" placeholder="例：metro:人民广场:14号口" />
                    </div>
                    <div class="field">
                      <label for="f-lock-exclude">排除点位</label>
                      <input id="f-lock-exclude" type="text" name="lock_exclude" placeholder="例：bus:17:大三侧" />
                    </div>
                  </div>
                </details>

                <div class="field field--full">
                  <label for="f-brief">一句话 Brief 补充（可选）</label>
                  <textarea id="f-brief" name="brief_text" rows="2" placeholder="例：乐高 2027 暑期，500 万，公交地铁组合覆盖亲子家庭，走直客"></textarea>
                  <div class="input-submit">
                    <button type="button" class="btn btn--primary btn--lg" id="btn-generate" style="flex:1">
                      启动 Agent 生成方案
                      <svg class="ico-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M4.5 10H15.5M15.5 10L11 5.5M15.5 10L11 14.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                  <span class="muted t-xs" id="run-note" style="margin-top:4px"></span>
                </div>

                <span class="field__error field--full" id="form-error" data-error="form" hidden></span>
              </div>
            </div>
          </div>

          <!-- Agent 实时通信与 8 阶段管线 -->
          <div class="card pipeline-card">
            <div class="stage-live" data-out="stage-live">等待启动</div>
            <div class="stages input-stages" id="run-stages" aria-label="运行阶段">
              <div class="stage" data-stage="intake" data-state="pending"><b>解析</b></div>
              <div class="stage" data-stage="data_inventory" data-state="pending"><b>红豆</b></div>
              <div class="stage" data-stage="data_bigdata" data-state="pending"><b>新云</b></div>
              <div class="stage" data-stage="engine" data-state="pending"><b>求解</b></div>
              <div class="stage" data-stage="data_routes" data-state="pending"><b>线路</b></div>
              <div class="stage" data-stage="visualize" data-state="pending"><b>地图</b></div>
              <div class="stage" data-stage="narrative" data-state="pending"><b>话术</b></div>
              <div class="stage" data-stage="done" data-state="pending"><b>完成</b></div>
            </div>

            <div class="dialog" id="agent-dialog" role="log" aria-live="polite" aria-label="Agent 交流" style="margin-top:16px">
              <div class="msg msg--agent">
                <div class="msg__head">AGENT · READY</div>
                确认左侧参数后点击「启动 Agent 生成方案」；系统将自动拉取实时红豆库存、注入新云线路轨迹并输出四页交互方案与官方 PDF。
              </div>
            </div>
          </div>
        </div>

        <!-- 右栏：上海暗色圈层预览 + 精简数据源状态 -->
        <div class="grail input-split__rail">
          <div class="card">
            <div class="card-head">
              <span>上海场馆与覆盖圈层预览</span>
              <span class="chip chip--quiet mono" data-out="map-status">加载中</span>
            </div>
            <div class="map-frame" id="input-map" data-default-venue="lego_shanghai" data-mode="fallback" style="border:0;border-radius:0;min-height:580px">
              <div id="amap"></div>
              <div class="map-fallback">
                <StaticMap showPois labels />
              </div>
              <div class="map-note" data-map-note>暗色矢量图层预览</div>
              <div class="map-legend">
                <span><i class="ring"></i>场馆辐射圈</span>
                <span><i class="accent"></i>入选点位</span>
                <span><i></i>地铁出入口</span>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-head">
              <span>数据源实时遥测</span>
              <span class="chip chip--quiet mono" data-out="data-version">—</span>
            </div>
            <div class="card-body" style="padding:14px 20px">
              <div class="kv">
                <div><span>红豆库存快照</span><b data-out="inventory-ts" class="mono">—</b></div>
                <div><span>已覆盖档期</span><b data-out="inventory-months" class="mono">—</b></div>
                <div><span>新云大数据会话</span><b data-out="xinyun-status">—</b></div>
              </div>
              <p class="faint t-xs" style="margin-top:10px" data-out="xinyun-note">新云 2023-05 轨迹与 POI 补充需本机人工登录一次，未登录时自动降级不阻塞求解。</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
</Base>
<script>
  import '../scripts/input';

  // Wire budget preset pills cleanly to #f-budget range slider
  const budgetInput = document.getElementById('f-budget') as HTMLInputElement | null;
  const budgetVal = document.getElementById('budget-val');
  const presets = [...document.querySelectorAll<HTMLButtonElement>('[data-budget-preset]')];
  function syncPresets() {
    if (!budgetInput) return;
    const cur = String(budgetInput.value);
    presets.forEach((b) => b.classList.toggle('is-active', b.dataset.budgetPreset === cur));
  }
  presets.forEach((b) => {
    b.addEventListener('click', () => {
      if (!budgetInput) return;
      budgetInput.value = b.dataset.budgetPreset || '500';
      if (budgetVal) budgetVal.textContent = budgetInput.value;
      budgetInput.dispatchEvent(new Event('input', { bubbles: true }));
      budgetInput.dispatchEvent(new Event('change', { bubbles: true }));
      syncPresets();
    });
  });
  budgetInput?.addEventListener('input', syncPresets);
</script>
