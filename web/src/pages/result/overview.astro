---
import Base from '../../layouts/Base.astro';
import ResultHeader from '../../components/ResultHeader.astro';
---
<Base
  title="方案概览 · 新云媒介提案台"
  description="运行状态、核心 KPI、官方模板 PDF 交付中心、Campaign 假设书 H1–H7、策略与媒体配比。"
  active=""
>
<main id="top" class="page">
  <ResultHeader active="overview" title="方案概览" />

  <div data-result-empty hidden class="empty">
    <div class="wrap">
      <h2 class="empty__title">暂无可展示的方案</h2>
      <p class="empty__body" data-empty-body>当前链接缺少有效的 run 参数，或该方案尚未生成完成。请返回方案工作台重新生成。</p>
      <a class="btn btn--primary btn--lg" href="/input.html">前往方案工作台</a>
    </div>
  </div>

  <div data-result-content class="app-section" hidden>
    <div class="wrap" style="display:grid;gap:var(--s-6)">
      <!-- 核心参数摘要 + 4 大 KPI -->
      <section aria-label="方案摘要">
        <p class="muted t-small mono" data-k="inputs-line" style="margin-bottom:var(--s-4)">—</p>
        <div class="kpi-grid">
          <div class="kpi">
            <span class="kpi__label">估算有效曝光</span>
            <span class="kpi__value gold" data-k="impressions">—</span>
            <span class="kpi__sub">周期累计曝光人次</span>
          </div>
          <div class="kpi">
            <span class="kpi__label">目标人群 Reach</span>
            <span class="kpi__value" style="color:var(--emerald)" data-k="reach">—</span>
            <span class="kpi__sub">单一饱和曲线合并口径</span>
          </div>
          <div class="kpi">
            <span class="kpi__label">平均触达频次</span>
            <span class="kpi__value" data-k="frequency">—</span>
            <span class="kpi__sub">Frequency（次）</span>
          </div>
          <div class="kpi">
            <span class="kpi__label">千次曝光成本</span>
            <span class="kpi__value" data-k="cpm">—</span>
            <span class="kpi__sub">CPM（元）</span>
          </div>
        </div>
      </section>

      <!-- 3 套确定性策略方案横向对比与一键切换 -->
      <section aria-labelledby="ov-var-h" data-variant-section hidden>
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:var(--s-4);margin-bottom:var(--s-4);flex-wrap:wrap">
          <h2 id="ov-var-h" class="heading-5">三套 CP-SAT 差异化方案对比</h2>
        </div>
        <div class="variant-grid" data-k="variant-cards"></div>
      </section>

      <!-- 官方模板交付中心（4 张可点击 Bento 卡片，去除重复下载按钮） -->
      <section aria-labelledby="ov-docs-h" data-doc-panel>
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:var(--s-4);margin-bottom:var(--s-4);flex-wrap:wrap">
          <h2 id="ov-docs-h" class="heading-5">官方模板交付中心</h2>
          <span class="faint t-xs mono">自动填入本次 run 真实点位、报价与条款 · 点击卡片直接下载 PDF</span>
        </div>

        <div class="doc-grid">
          <a class="doc-tile doc-tile--primary" data-doc-card="proposal" data-doc-link="proposal" href="#" download>
            <div class="doc-tile__top">
              <span class="doc-tile__ico" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                  <rect x="2.5" y="4" width="15" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M6.5 17.5H13.5M10 15V17.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="chip chip--accent">16:9 PPT版</span>
            </div>
            <div class="doc-tile__title">销售提案方案</div>
            <p class="doc-tile__desc">复刻新云历史销售提案模板：黑金封面、策略洞察、轨迹覆盖地图、双栏线路明细、报价排期与赠媒实景。</p>
            <div class="doc-tile__foot">
              <span class="mono">历史销售提案样本</span>
              <span>下载 PDF →</span>
            </div>
          </a>

          <a class="doc-tile" data-doc-card="contract-direct" data-doc-link="contract-direct" href="#" download>
            <div class="doc-tile__top">
              <span class="doc-tile__ico" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                  <path d="M5.5 2.5H12L15.5 6V17.5H5.5V2.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="M8 10H13M8 13H11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="chip chip--quiet" data-doc-badge="contract-direct">A4 竖版</span>
            </div>
            <div class="doc-tile__title">直客广告发布合同</div>
            <p class="doc-tile__desc">依据《M3-直客合同》自动填入全量入选线路、刊例/折扣/制作费、付款节点及第 1–8 条完整法律条款。</p>
            <div class="doc-tile__foot">
              <span class="mono">M3-直客合同</span>
              <span>下载 PDF →</span>
            </div>
          </a>

          <a class="doc-tile" data-doc-card="contract-4a-order" data-doc-link="contract-4a-order" href="#" download>
            <div class="doc-tile__top">
              <span class="doc-tile__ico" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                  <rect x="2.5" y="4.5" width="15" height="11" rx="1.8" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M2.5 8.5H17.5M8 8.5V15.5M13 8.5V15.5" stroke="currentColor" stroke-width="1.4"/>
                </svg>
              </span>
              <span class="chip chip--quiet" data-doc-badge="contract-4a-order">A4 横版</span>
            </div>
            <div class="doc-tile__title">4A 户外排期表（订单）</div>
            <p class="doc-tile__desc">依据《M3-4A订单》Proposed Outdoor Spot Plan 双语表式填入位置、档期、刊例、折扣、净价与制作费。</p>
            <div class="doc-tile__foot">
              <span class="mono">M3-4A订单</span>
              <span>下载 PDF →</span>
            </div>
          </a>

          <a class="doc-tile" data-doc-card="contract-4a-framework" data-doc-link="contract-4a-framework" href="#" download>
            <div class="doc-tile__top">
              <span class="doc-tile__ico" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                  <path d="M5 3H13.5L16 5.5V17H5V3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="M7.5 8.5H13.5M7.5 11.5H13.5M7.5 14.5H11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="chip chip--quiet" data-doc-badge="contract-4a-framework">A4 竖版</span>
            </div>
            <div class="doc-tile__title">4A 年度框架合同书</div>
            <p class="doc-tile__desc">完整保留《M3-4A框架》18 条正文与附件一创意制作通用条款，自动联动合同年份、主体与有效期。</p>
            <div class="doc-tile__foot">
              <span class="mono">M3-4A框架</span>
              <span>下载 PDF →</span>
            </div>
          </a>
        </div>
      </section>

      <!-- Campaign 假设书 H1-H7 -->
      <section aria-labelledby="ov-hyp-h">
        <h2 id="ov-hyp-h" class="heading-5" style="margin-bottom:var(--s-4)">Campaign 假设书</h2>
        <div class="hyp" data-k="hypothesis"></div>
        <div class="card" style="margin-top:var(--s-4)">
          <div class="card-head"><span>核心一句话策略</span><span class="chip chip--accent">One-Liner</span></div>
          <div class="card-body">
            <p style="font-size:16px;line-height:26px;color:var(--ink)" data-k="one-liner">—</p>
          </div>
        </div>
      </section>

      <!-- 策略 / 人群 / 交通 / 媒介角色 -->
      <section aria-labelledby="ov-strat-h">
        <h2 id="ov-strat-h" class="heading-5" style="margin-bottom:var(--s-4)">策略 · 人群 · 交通与媒介角色</h2>
        <div class="gsplit">
          <div class="card">
            <div class="card-head"><span>策略主线</span></div>
            <div class="card-body">
              <p style="font-size:14px;line-height:24px;color:var(--ink-soft)" data-k="strategy">—</p>
            </div>
          </div>
          <div class="card">
            <div class="card-head"><span>人群与交通结构</span></div>
            <div class="card-body" style="padding:12px 20px">
              <div class="kv" data-k="audi-transport"></div>
            </div>
          </div>
        </div>
        <div class="card" style="margin-top:var(--s-4)">
          <div class="card-head"><span>媒介角色分配</span></div>
          <div class="card-body" style="padding:8px 20px">
            <div class="rows" data-k="media-roles"></div>
          </div>
        </div>
      </section>

      <!-- 媒体配比 -->
      <section aria-labelledby="ov-mix-h">
        <h2 id="ov-mix-h" class="heading-5" style="margin-bottom:var(--s-4)">媒体结构配比</h2>
        <div class="card">
          <div class="card-head"><span>按折后媒体费占比</span></div>
          <div class="card-body" style="display:grid;gap:var(--s-4)">
            <svg class="chart" viewBox="0 0 360 48" role="img" aria-label="媒体配比条形图：公交与地铁按折后媒体费的占比">
              <rect x="0" y="0" width="360" height="14" rx="7" fill="#d0d6e0"></rect>
              <rect class="bar" data-k="bus-bar" x="0" y="0" width="0" height="14" rx="7"></rect>
              <rect class="bar bar--alt" data-k="metro-bar" x="0" y="0" width="0" height="14" rx="7"></rect>
              <text x="0" y="36" font-size="11" data-k="bus-label">公交 0%</text>
              <text x="360" y="36" text-anchor="end" font-size="11" data-k="metro-label">地铁 0%</text>
            </svg>
            <div class="kv">
              <div><span>公交线路 / 车辆</span><b data-k="bus-units">—</b></div>
              <div class="kv__raised"><span>地铁站点 / 出入口</span><b data-k="metro-units">—</b></div>
              <div class="total"><span>总付费单元</span><b data-k="paid-units">—</b></div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>
</Base>
<script>
  import { initResult, buildPdfUrl, navigateVariant } from '../../scripts/result';
  import { fmtWan, pctReadable, ratioPct } from '../../lib/format';

  initResult((plan, run, activeVariant = 'balanced') => {
    const inputs = plan.inputs || {};
    const effects = plan.effects || {};
    const hyp = plan.hypothesis || {};
    const strategy = plan.strategy || {};
    const summary = plan.plan?.summary || {};

    const h1 = `${inputs.venue_name || plan.venue?.name || '方案'} · ${inputs.budget_wan ?? '—'} 万`;
    const title = document.querySelector('[data-result-title]');
    if (title) title.textContent = h1;
    document.querySelector('[data-k="inputs-line"]')!.textContent =
      `${inputs.industry || '乐园'} · ${(inputs.media || []).map((m: string) => (m === 'bus' ? '公交车身' : '地铁出入口')).join(' + ')} · ${inputs.weeks ?? '—'} 周 · ${inputs.customer_type_label || (inputs.customer_type === '4a' ? '4A 代理' : '直客')} · 档期 ${inputs.start_date ?? '—'} → ${inputs.end_date ?? '—'}`;

    // Render 3-strategy comparison cards if present
    const variants = (run as any)?.variants;
    const varSec = document.querySelector<HTMLElement>('[data-variant-section]');
    const varGrid = document.querySelector<HTMLElement>('[data-k="variant-cards"]');
    if (varSec && varGrid && variants?.comparison?.length > 1) {
      varSec.hidden = false;
      varGrid.replaceChildren();
      variants.comparison.forEach((v: any) => {
        const isAct = v.mode === activeVariant;
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'variant-card' + (isAct ? ' is-active' : '');
        card.setAttribute('aria-pressed', String(isAct));
        card.innerHTML = `
          <div class="variant-card__head">
            <span class="variant-card__title">${v.title || v.short}</span>
            <span class="variant-radio" aria-hidden="true">
              ${isAct
                ? `<svg viewBox="0 0 16 16" fill="none"><path d="M3.5 8.2L6.6 11.3L12.5 5.2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`
                : ''}
            </span>
          </div>
          <p class="variant-card__tag">${v.tagline || ''}</p>
          <div class="variant-card__kpis">
            <div><span>有效曝光</span><b>${fmtWan((v.impressions || 0) / 10000, 0)}万</b></div>
            <div><span>Reach</span><b>${pctReadable(v.reach_pct ?? v.reach)}</b></div>
            <div><span>CPM</span><b>¥${fmtWan(v.cpm_yuan, 1)}</b></div>
          </div>
          <div class="variant-card__meta">
            <span>公交 ${v.bus_lines}线/${v.bus_units}辆 · 地铁 ${v.metro_stations}站</span>
            <span class="variant-card__paid">实付 ¥${fmtWan(v.total_paid_wan, 1)}万</span>
          </div>
          <div class="variant-card__foot">
            <span class="variant-card__state">${isAct ? '当前生效方案' : '点击切换此方案'}</span>
            <span class="variant-card__arrow" aria-hidden="true">${isAct ? '●' : '→'}</span>
          </div>
        `;
        card.addEventListener('click', () => {
          if (v.mode !== activeVariant) navigateVariant(v.mode);
        });
        varGrid.append(card);
      });
    }

    // Wire 4 official PDF tiles + highlight matched customer contract (preserving ?variant=)
    const runId = (run as any)?.run_id;
    const is4a = inputs.customer_type === '4a';
    const docPanel = document.querySelector<HTMLElement>('[data-doc-panel]');
    if (runId) {
      const urlMap: Record<string, string> = {
        'proposal': buildPdfUrl(runId, 'proposal', activeVariant),
        'contract-direct': buildPdfUrl(runId, 'contract-direct', activeVariant),
        'contract-4a-order': buildPdfUrl(runId, 'contract-4a-order', activeVariant),
        'contract-4a-framework': buildPdfUrl(runId, 'contract-4a-framework', activeVariant),
      };
      document.querySelectorAll<HTMLAnchorElement>('[data-doc-link]').forEach((el) => {
        const key = el.dataset.docLink || '';
        if (urlMap[key]) el.href = urlMap[key];
      });
      const highlightKeys = is4a ? ['contract-4a-order', 'contract-4a-framework'] : ['contract-direct'];
      (['contract-direct', 'contract-4a-order', 'contract-4a-framework'] as const).forEach((k) => {
        const card = document.querySelector<HTMLElement>(`[data-doc-card="${k}"]`);
        const badge = document.querySelector<HTMLElement>(`[data-doc-badge="${k}"]`);
        const on = highlightKeys.includes(k);
        if (card) card.classList.toggle('doc-tile--primary', on);
        if (badge) {
          badge.textContent = on ? '当前客户匹配' : (k === 'contract-4a-order' ? 'A4 横版' : 'A4 竖版');
          badge.className = 'chip ' + (on ? 'chip--accent' : 'chip--quiet');
        }
      });
    } else if (docPanel) {
      docPanel.hidden = true;
    }

    set('[data-k="impressions"]', `${fmtWan((effects.impressions || 0) / 10000, 1)} 万`);
    set('[data-k="reach"]', pctReadable(effects.reach_pct ?? effects.reach));
    set('[data-k="frequency"]', fmtWan(effects.frequency, 1));
    set('[data-k="cpm"]', fmtWan(effects.cpm_yuan, 2));

    // hypothesis
    const hypEl = document.querySelector('[data-k="hypothesis"]')!;
    hypEl.replaceChildren();
    (hyp.fields || []).forEach((f: any) => {
      const it = document.createElement('div');
      it.className = 'hyp__item';
      const id = document.createElement('span'); id.className = 'hyp__id'; id.textContent = f.id;
      const body = document.createElement('div');
      const label = document.createElement('div'); label.className = 'hyp__label'; label.textContent = f.label;
      const val = document.createElement('div'); val.className = 'hyp__value'; val.textContent = f.value;
      body.append(label, val);
      it.append(id, body);
      hypEl.append(it);
    });
    set('[data-k="one-liner"]', hyp.one_liner || '—');

    // strategy
    set('[data-k="strategy"]', strategy.one_liner || plan.strategy?.one_liner || '—');
    const at = document.querySelector('[data-k="audi-transport"]')!;
    at.replaceChildren();
    const aud = strategy.audience || {};
    const tr = strategy.transport || {};
    const atRows: [string, string][] = [];
    if (aud.primary) atRows.push(['核心人群', aud.primary]);
    if (aud.secondary) atRows.push(['次级人群', aud.secondary]);
    if (tr.metro_access) atRows.push(['地铁可达', tr.metro_access]);
    if (tr.note) atRows.push(['交通说明', tr.note]);
    atRows.forEach(([k, v]) => {
      const d = document.createElement('div');
      d.innerHTML = `<span>${k}</span><b>${v}</b>`;
      at.append(d);
    });

    // media roles
    const mr = document.querySelector('[data-k="media-roles"]')!;
    mr.replaceChildren();
    (strategy.media_roles || []).forEach((r: any) => {
      const row = document.createElement('div');
      row.className = 'row';
      const mark = document.createElement('span'); mark.className = 'row__mark'; mark.textContent = r.media === 'bus' ? 'B' : 'M';
      const main = document.createElement('div');
      const b = document.createElement('b'); b.textContent = r.role || r.media;
      const small = document.createElement('small'); small.textContent = r.share_target != null ? `目标占比 ${Math.round(r.share_target * 100)}%` : '';
      main.append(b, small);
      row.append(mark, main, document.createTextNode(''));
      mr.append(row);
    });

    // media mix
    const busPct = summary.media_mix?.bus_pct ?? 0;
    const metroPct = summary.media_mix?.metro_pct ?? 0;
    const busBar = document.querySelector('[data-k="bus-bar"]') as SVGElement; busBar.setAttribute('width', String(busPct * 360));
    const metroBar = document.querySelector('[data-k="metro-bar"]') as SVGElement; metroBar.setAttribute('x', String(busPct * 360)); metroBar.setAttribute('width', String(metroPct * 360));
    set('[data-k="bus-label"]', `公交 ${ratioPct(busPct)}`);
    set('[data-k="metro-label"]', `地铁 ${ratioPct(metroPct)}`);
    set('[data-k="bus-units"]', `${summary.bus_lines ?? '—'} 条 / ${summary.bus_units ?? '—'} 辆`);
    set('[data-k="metro-units"]', `${summary.metro_stations ?? '—'} 站 / ${summary.metro_units ?? '—'} 口`);
    set('[data-k="paid-units"]', String((summary.bus_units ?? 0) + (summary.metro_units ?? 0)));

    function set(sel: string, v: string) {
      const el = document.querySelector(sel);
      if (el) el.textContent = v;
    }
  });
</script>
