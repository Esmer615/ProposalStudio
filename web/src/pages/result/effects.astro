---
import Base from '../../layouts/Base.astro';
import ResultHeader from '../../components/ResultHeader.astro';

// Effects: KPI (曝光/GRP/Reach/Frequency/CPM) + by-media, elasticity dual-axis + 9-budget table,
// validator checks / self-check-10, limitations, data source/version/timestamp, agent+data timeline.
---
<Base
  title="效果与校验 · 新云媒介提案台"
  description="曝光、GRP、Reach、Frequency、CPM，分媒体归因，预算弹性双轴与九档表，validator 校验与局限。"
  active=""
>
<main id="top" class="page">
  <ResultHeader active="effects" title="效果与校验" />

  <div data-result-empty hidden class="empty section">
    <div class="wrap">
      <h2 class="empty__title">暂无可展示的方案</h2>
      <p class="empty__body" data-empty-body>没有有效的 run 参数。请返回输入页重新生成。</p>
      <a class="btn btn--primary" href="/input.html">去生成方案</a>
    </div>
  </div>

  <div data-result-content class="app-section" hidden>
    <div class="wrap" style="display:grid;gap:var(--s-6)">

      <!-- effects KPIs -->
      <section aria-labelledby="fx-kpi-h">
        <h2 id="fx-kpi-h" class="heading-5" style="margin-bottom:var(--s-4)">效果估算 KPI</h2>
        <div class="kpi-grid">
          <div class="kpi"><span class="kpi__label">有效曝光</span><span class="kpi__value gold" data-k="impressions">—</span><span class="kpi__sub">人次</span></div>
          <div class="kpi"><span class="kpi__label">GRP</span><span class="kpi__value" data-k="grp">—</span><span class="kpi__sub">毛评点</span></div>
          <div class="kpi"><span class="kpi__label">Reach</span><span class="kpi__value" style="color:var(--emerald)" data-k="reach">—</span><span class="kpi__sub">去重到达率</span></div>
          <div class="kpi"><span class="kpi__label">Frequency</span><span class="kpi__value" data-k="frequency">—</span><span class="kpi__sub">平均频次</span></div>
        </div>
        <div class="kpi-grid" style="margin-top:var(--s-4)">
          <div class="kpi"><span class="kpi__label">CPM</span><span class="kpi__value" data-k="cpm">—</span><span class="kpi__sub">元 / 千次曝光</span></div>
          <div class="kpi"><span class="kpi__label">目标人群基数</span><span class="kpi__value" data-k="target-pop">—</span><span class="kpi__sub">策划假设口径</span></div>
          <div class="kpi" style="grid-column:span 2"><span class="kpi__label">分媒体归因（不直接相加到达率）</span><div data-k="by-media" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:6px">—</div></div>
        </div>
      </section>

      <!-- 新云大数据实测洞察：全天人流密度与受众四维画像（2023-05） -->
      <section aria-labelledby="fx-portrait-h" data-portrait-section hidden>
        <div style="display:flex;align-items:baseline;justify-content:space-between;gap:var(--s-4);margin-bottom:var(--s-4);flex-wrap:wrap">
          <h2 id="fx-portrait-h" class="heading-5">新云大数据实测洞察 · 人流密度与受众画像</h2>
          <span class="chip chip--accent mono" data-k="portrait-meta">2023-05 平台实测</span>
        </div>

        <div class="kpi-grid" style="margin-bottom:var(--s-4)">
          <div class="kpi"><span class="kpi__label">实测覆盖 PV</span><span class="kpi__value gold" data-k="p-pv">—</span><span class="kpi__sub">选中线路聚合月 PV</span></div>
          <div class="kpi"><span class="kpi__label">去重覆盖 UV</span><span class="kpi__value" style="color:var(--emerald)" data-k="p-uv">—</span><span class="kpi__sub">选中线路去重触达人数</span></div>
          <div class="kpi"><span class="kpi__label">精准覆盖 PV</span><span class="kpi__value" data-k="p-acc">—</span><span class="kpi__sub">高有效视线覆盖</span></div>
          <div class="kpi"><span class="kpi__label">实测匹配线路</span><span class="kpi__value" data-k="p-lines">—</span><span class="kpi__sub">含单线画像明细</span></div>
        </div>

        <div class="portrait-grid">
          <div class="card">
            <div class="card-head"><span>全天时段人流密度（人次）</span><span class="chip chip--quiet mono">早 / 午 / 晚 / 夜</span></div>
            <div class="card-body"><div class="bar-list" data-k="p-flow"></div></div>
          </div>
          <div class="card">
            <div class="card-head"><span>受众年龄结构分布</span><span class="chip chip--quiet mono">%</span></div>
            <div class="card-body"><div class="bar-list" data-k="p-age"></div></div>
          </div>
          <div class="card">
            <div class="card-head"><span>性别构成与房产拥有结构</span><span class="chip chip--quiet mono">中产家庭指标</span></div>
            <div class="card-body" style="display:grid;gap:14px">
              <div>
                <div style="display:flex;justify-content:space-between;font-size:12px">
                  <span data-k="p-male">男性 —</span>
                  <span data-k="p-female">女性 —</span>
                </div>
                <div class="gender-bar">
                  <div class="gender-bar__male" data-k="p-male-bar" style="width:50%"></div>
                  <div class="gender-bar__female" data-k="p-female-bar" style="width:50%"></div>
                </div>
              </div>
              <div class="bar-list" data-k="p-house"></div>
            </div>
          </div>
          <div class="card">
            <div class="card-head"><span>消费能力分层与终端品牌 Top</span><span class="chip chip--quiet mono">2023-05</span></div>
            <div class="card-body" style="display:grid;gap:14px">
              <div class="bar-list" data-k="p-cons"></div>
              <div class="poi-chips" data-k="p-phones"></div>
            </div>
          </div>
        </div>

        <div class="table-shell" style="margin-top:var(--s-4)" data-per-line-shell hidden>
          <div class="table-scroll">
            <table class="data">
              <thead>
                <tr>
                  <th>实测线路</th><th class="num">覆盖 PV(万)</th><th class="num">去重 UV(万)</th><th class="num">午间峰值人流</th><th class="num">男 / 女(%)</th><th>30–50岁占比</th><th>Top 手机品牌</th>
                </tr>
              </thead>
              <tbody data-k="p-perline-rows"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- elasticity dual-axis + 9-budget table -->
      <section aria-labelledby="fx-elast-h">
        <h2 id="fx-elast-h" class="heading-5" style="margin-bottom:var(--s-4)">预算弹性曲线（100–500 万）</h2>
        <div class="card">
          <div class="card-head">
            <span>累计曝光（紫罗兰线 · 左轴）· 边际每万元曝光（薄荷虚线 · 右轴）</span>
            <span class="chip chip--accent mono" data-k="knee">拐点 —</span>
          </div>
          <div class="card-body">
            <svg class="chart" data-k="elast-chart" viewBox="0 0 1200 360" role="img" aria-label="预算弹性双轴图"></svg>
            <p class="faint t-xs" style="margin-top:var(--s-3)" data-k="elast-note">—</p>
          </div>
        </div>
        <div class="table-shell" style="margin-top:var(--s-4)">
          <div class="table-scroll">
            <table class="data">
              <thead>
                <tr><th class="num">预算(万)</th><th class="num">曝光(万)</th><th class="num">Reach</th><th class="num">频率</th><th class="num">CPM(元)</th><th class="num">边际曝光/万</th></tr>
              </thead>
              <tbody data-k="elast-rows"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- validator checks + self-check-10 -->
      <section aria-labelledby="fx-val-h">
        <h2 id="fx-val-h" class="heading-5" style="margin-bottom:var(--s-4)">确定性自主校验</h2>
        <div class="gsplit">
          <div class="card">
            <div class="card-head"><span>Validator 独立检查</span><span class="chip" data-k="val-pass">—</span></div>
            <div class="card-body" style="padding:8px 20px"><div data-k="checks"></div></div>
          </div>
          <div class="card">
            <div class="card-head"><span>10 项交付自检</span></div>
            <div class="card-body" style="padding:8px 20px"><div data-k="self-check"></div></div>
          </div>
        </div>
      </section>

      <!-- limitations + data source -->
      <section aria-labelledby="fx-limits-h">
        <h2 id="fx-limits-h" class="heading-5" style="margin-bottom:var(--s-4)">局限与数据溯源</h2>
        <div class="card">
          <div class="card-body" style="padding:12px 20px;display:grid;gap:12px">
            <div class="kv" data-k="limits"></div>
            <div class="kv" data-k="sources"></div>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>
</Base>
<script>
  import { initResult } from '../../scripts/result';
  import { fmtWan, fmtInt, pctReadable, ratioPct, nf } from '../../lib/format';

  initResult((plan, run) => {
    const e = plan.effects || {};
    const params = e.parameters || {};
    const validation = plan.validation || {};
    // The orchestrator keeps the nine-budget sweep on the run (`/api/proposals/{id}`),
    // while a direct /api/plan response may carry it inside the plan. Prefer the run.
    const runElast = (run as any)?.elasticity;
    const elast = (runElast?.points?.length) ? runElast
      : (plan.elasticity && plan.elasticity.points?.length) ? plan.elasticity : null;

    set('[data-k="impressions"]', `${fmtWan((e.impressions || 0) / 10000, 1)} 万`);
    set('[data-k="grp"]', fmtWan(e.grp, 1));
    set('[data-k="reach"]', pctReadable(e.reach_pct ?? e.reach));
    set('[data-k="frequency"]', fmtWan(e.frequency, 1));
    set('[data-k="cpm"]', fmtWan(e.cpm_yuan, 2));
    set('[data-k="target-pop"]', `${fmtWan((e.target_population || 0) / 10000, 0)} 万`);

    // by-media
    const byMedia = document.querySelector('[data-k="by-media"]')!;
    byMedia.replaceChildren();
    (e.by_media || []).forEach((m: any) => {
      const s = document.createElement('span');
      s.className = 'chip chip--quiet';
      s.style.marginRight = '8px';
      s.textContent = `${m.media === 'bus' ? '公交' : '地铁'} ${ratioPct(m.share)} · CPM ${fmtWan(m.cpm_yuan, 1)} 元`;
      byMedia.append(s);
    });
    if (!(e.by_media || []).length) byMedia.textContent = '—';

    // Render xinyun-bigdata real portrait & crowd density dashboard
    const portrait = (run as any)?.data?.portrait;
    const agg = portrait?.aggregate;
    const pSec = document.querySelector<HTMLElement>('[data-portrait-section]');
    if (pSec && agg) {
      pSec.hidden = false;
      set('[data-k="portrait-meta"]', `${portrait.data_month || '202305'} 实测 · 匹配 ${portrait.matched?.length || 0} 条公交线`);
      set('[data-k="p-pv"]', agg.cover_pv != null ? `${fmtWan(agg.cover_pv / 10000, 1)} 万` : '—');
      set('[data-k="p-uv"]', agg.cover_uv != null ? `${fmtWan(agg.cover_uv / 10000, 1)} 万` : '—');
      set('[data-k="p-acc"]', agg.cover_pv_accurate != null ? `${fmtWan(agg.cover_pv_accurate / 10000, 1)} 万` : '—');
      set('[data-k="p-lines"]', `${portrait.matched?.length || 0} 条`);

      const renderBars = (sel: string, items: [string, number, string][], emerald = false) => {
        const el = document.querySelector(sel);
        if (!el) return;
        el.replaceChildren();
        const mx = Math.max(1, ...items.map((x) => x[1]));
        items.forEach(([lbl, val, txt]) => {
          const r = document.createElement('div');
          r.className = 'bar-row';
          r.innerHTML = `<span class="bar-row__lbl">${lbl}</span><span class="bar-row__track"><span class="bar-row__fill${emerald ? ' bar-row__fill--emerald' : ''}" style="width:${Math.min(100, Math.round((val / mx) * 100))}%"></span></span><span class="bar-row__val">${txt}</span>`;
          el.append(r);
        });
      };

      if (agg.flow_periods) {
        const fp = agg.flow_periods;
        renderBars('[data-k="p-flow"]', [
          ['早高峰', Number(fp.morning || 0), fmtInt(fp.morning || 0)],
          ['午间时段', Number(fp.midday || 0), fmtInt(fp.midday || 0)],
          ['晚高峰', Number(fp.evening || 0), fmtInt(fp.evening || 0)],
          ['夜间时段', Number(fp.night || 0), fmtInt(fp.night || 0)],
        ]);
      }
      renderBars('[data-k="p-age"]', [
        ['20岁以下', Number(agg.under20_pct || 0), `${agg.under20_pct ?? 0}%`],
        ['20–30岁', Number(agg.age_20_30_pct || 0), `${agg.age_20_30_pct ?? 0}%`],
        ['30–40岁', Number(agg.age_30_40_pct || 0), `${agg.age_30_40_pct ?? 0}%`],
        ['40–50岁', Number(agg.age_40_50_pct || 0), `${agg.age_40_50_pct ?? 0}%`],
        ['50岁以上', Number(agg.age_50plus_pct || 0), `${agg.age_50plus_pct ?? 0}%`],
      ], true);

      const mPct = Number(agg.male_pct ?? 50);
      const fPct = Number(agg.female_pct ?? 50);
      set('[data-k="p-male"]', `男性 ${mPct}%`);
      set('[data-k="p-female"]', `女性 ${fPct}%`);
      const mb = document.querySelector<HTMLElement>('[data-k="p-male-bar"]');
      const fb = document.querySelector<HTMLElement>('[data-k="p-female-bar"]');
      if (mb) mb.style.width = `${mPct}%`;
      if (fb) fb.style.width = `${fPct}%`;

      if (agg.house_pct) {
        renderBars('[data-k="p-house"]', [
          ['一套房产', Number(agg.house_pct.one || 0), `${agg.house_pct.one ?? 0}%`],
          ['无房租住', Number(agg.house_pct.zero || 0), `${agg.house_pct.zero ?? 0}%`],
          ['两套房产', Number(agg.house_pct.two || 0), `${agg.house_pct.two ?? 0}%`],
          ['多套房产', Number(agg.house_pct.more || 0), `${agg.house_pct.more ?? 0}%`],
        ]);
      }

      if (agg.consumption) {
        renderBars('[data-k="p-cons"]', [
          ['中等消费', Number(agg.consumption.middle || 0), `${agg.consumption.middle ?? 0}%`],
          ['高消费力', Number(agg.consumption.high || 0), `${agg.consumption.high ?? 0}%`],
          ['大众消费', Number(agg.consumption.low || 0), `${agg.consumption.low ?? 0}%`],
        ], true);
      }

      const phonesEl = document.querySelector('[data-k="p-phones"]');
      if (phonesEl && Array.isArray(agg.top_phones)) {
        phonesEl.replaceChildren();
        agg.top_phones.slice(0, 8).forEach((p: any) => {
          const s = document.createElement('span');
          s.className = 'poi-chip';
          s.innerHTML = `${p.phone_name}<b>${p.num}</b>`;
          phonesEl.append(s);
        });
      }

      // Per-line real portrait table
      const perLine = portrait.per_line || {};
      const plEntries = Object.entries(perLine);
      const plShell = document.querySelector<HTMLElement>('[data-per-line-shell]');
      const plTbody = document.querySelector('[data-k="p-perline-rows"]');
      if (plShell && plTbody && plEntries.length) {
        plShell.hidden = false;
        plTbody.replaceChildren();
        plEntries.forEach(([lineKey, entry]: [string, any]) => {
          const s = entry?.summary || {};
          const tr = document.createElement('tr');
          const ageMid = (Number(s.age_30_40_pct || 0) + Number(s.age_40_50_pct || 0)).toFixed(1);
          const topP = (s.top_phones || []).slice(0, 3).map((x: any) => x.phone_name).join(' / ') || '—';
          tr.innerHTML = `
            <td><b>${entry?.label?.thirdLabel || lineKey}</b></td>
            <td class="num">${s.cover_pv != null ? fmtWan(s.cover_pv / 10000, 1) : '—'}</td>
            <td class="num">${s.cover_uv != null ? fmtWan(s.cover_uv / 10000, 1) : '—'}</td>
            <td class="num">${s.flow_periods?.midday != null ? fmtInt(s.flow_periods.midday) : '—'}</td>
            <td class="num">${s.male_pct ?? '—'} / ${s.female_pct ?? '—'}</td>
            <td class="mono">${ageMid}%</td>
            <td>${topP}</td>
          `;
          plTbody.append(tr);
        });
      }
    }

    // elasticity
    if (elast) drawElasticity(elast);
    else {
      document.querySelector('[data-k="elast-chart"]')!.innerHTML = '<text x="20" y="30" font-size="13">九档弹性未加载（按需 /api/elasticity）</text>';
      set('[data-k="elast-note"]', '九档弹性为可选计算；本次 run 未返回弹性数据，价格与曝光仍以上方确定性结果为准。');
    }
    if (elast) set('[data-k="elast-note"]', elast.note || '');

    // validator checks
    const checks = validation.checks || [];
    const blockers = checks.filter((c: any) => c.level === 'blocker' && !c.passed);
    const passChip = document.querySelector('[data-k="val-pass"]')!;
    passChip.textContent = blockers.length ? `${blockers.length} blocker` : '通过';
    passChip.className = 'chip ' + (blockers.length ? 'chip--danger' : 'chip--accent');
    const checksEl = document.querySelector('[data-k="checks"]')!;
    checksEl.replaceChildren();
    checks.forEach((c: any) => {
      const r = document.createElement('div'); r.className = 'row'; r.style.gridTemplateColumns = '70px minmax(0,1fr) auto';
      const id = document.createElement('span'); id.className = 'mono faint'; id.textContent = c.id;
      const main = document.createElement('div');
      const b = document.createElement('b'); b.textContent = c.name;
      const small = document.createElement('small'); small.textContent = c.detail || '';
      main.append(b, small);
      const chip = document.createElement('span');
      chip.className = 'chip ' + (c.passed ? 'chip--quiet' : c.level === 'blocker' ? 'chip--danger' : 'chip--warn');
      chip.textContent = c.passed ? (c.level === 'blocker' ? '通过' : '通过') : '未通过';
      r.append(id, main, chip);
      checksEl.append(r);
    });

    // self-check 10
    const sc = document.querySelector('[data-k="self-check"]')!;
    sc.replaceChildren();
    (validation.self_check_10 || []).forEach((c: any) => {
      const r = document.createElement('div'); r.className = 'row'; r.style.gridTemplateColumns = '40px minmax(0,1fr) auto';
      const id = document.createElement('span'); id.className = 'mono faint'; id.textContent = c.id;
      const main = document.createElement('div'); const b = document.createElement('b'); b.textContent = c.text; main.append(b);
      const chip = document.createElement('span'); chip.className = 'chip ' + (c.passed ? 'chip--quiet' : 'chip--danger'); chip.textContent = c.passed ? '✓' : '✕';
      r.append(id, main, chip);
      sc.append(r);
    });

    // limitations
    const lim = document.querySelector('[data-k="limits"]')!;
    lim.replaceChildren();
    (validation.limitations || []).forEach((t: string, i: number) => {
      const d = document.createElement('div'); d.innerHTML = `<span>局限 ${String(i + 1).padStart(2, '0')}</span><b>${t}</b>`; lim.append(d);
    });

    // sources
    const src = document.querySelector('[data-k="sources"]')!;
    src.replaceChildren();
    const m = plan.meta || {};
    const inv = validation.inventory_check || {};
    [['数据来源', (plan.coverage?.sources || ['红豆广告媒体管理系统 2027 月度快照', '公开 POI/地图近似数据']).join('；')],
     ['数据版本', m.data_version || '—'],
     ['库存时间戳', inv.timestamp || m.inventory_ts || '—'],
     ['库存校验档期', inv.period || '—'],
     ['效果公式', e.formula || '—'],
     ['声明', e.disclaimer || '曝光估算，非到园人数/销量/财务 ROI。'],
    ].forEach(([k, v]) => { const d = document.createElement('div'); d.innerHTML = `<span>${k}</span><b>${v}</b>`; src.append(d); });

    function set(sel: string, v: string) { const el = document.querySelector(sel); if (el) el.textContent = v; }
  });

  // dual-axis elasticity chart (SVG): left = cumulative impressions, right = marginal per 万
  function drawElasticity(elast: any) {
    const pts = elast.points || [];
    const svg = document.querySelector('[data-k="elast-chart"]')!;
    svg.replaceChildren();
    const W = 1200, H = 360, padL = 64, padR = 64, padT = 24, padB = 48;
    const iw = W - padL - padR, ih = H - padT - padB;
    const bMin = Math.min(...pts.map((p: any) => p.budget_wan));
    const bMax = Math.max(...pts.map((p: any) => p.budget_wan));
    const iMax = Math.max(...pts.map((p: any) => p.impressions));
    const mMax = Math.max(...pts.map((p: any) => p.marginal_impressions_per_wan || 0));
    const x = (b: number) => padL + ((b - bMin) / (bMax - bMin)) * iw;
    const yI = (v: number) => padT + (1 - v / iMax) * ih;
    const yM = (v: number) => padT + (1 - v / mMax) * ih;

    // axis + grid
    for (let g = 0; g <= 4; g++) {
      const yy = padT + (g / 4) * ih;
      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', padL); line.setAttribute('x2', W - padR); line.setAttribute('y1', yy); line.setAttribute('y2', yy); line.setAttribute('class', 'grid-line');
      svg.append(line);
    }
    const xAxis = document.createElementNS('http://www.w3.org/2000/svg', 'line');
    xAxis.setAttribute('x1', padL); xAxis.setAttribute('x2', W - padR); xAxis.setAttribute('y1', padT + ih); xAxis.setAttribute('y2', padT + ih); xAxis.setAttribute('class', 'axis'); svg.append(xAxis);

    // left axis labels (impressions, 万)
    for (let g = 0; g <= 4; g++) {
      const v = (iMax * g) / 4;
      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x', padL - 8); t.setAttribute('y', yI(v) + 4); t.setAttribute('text-anchor', 'end');
      t.textContent = fmtWan(v / 10000, 1);
      svg.append(t);
    }
    // x labels
    pts.forEach((p: any) => {
      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x', x(p.budget_wan)); t.setAttribute('y', H - 20); t.setAttribute('text-anchor', 'middle');
      t.textContent = String(p.budget_wan);
      svg.append(t);
    });

    // area under impressions
    const areaPath = pts.map((p: any, i: number) => `${i === 0 ? 'M' : 'L'}${x(p.budget_wan).toFixed(1)} ${yI(p.impressions).toFixed(1)}`).join(' ') + ` L${x(bMax).toFixed(1)} ${padT + ih} L${x(bMin).toFixed(1)} ${padT + ih} Z`;
    const area = document.createElementNS('http://www.w3.org/2000/svg', 'path'); area.setAttribute('d', areaPath); area.setAttribute('class', 'area'); svg.append(area);

    // impressions line
    const iLine = pts.map((p: any, i: number) => `${i === 0 ? 'M' : 'L'}${x(p.budget_wan).toFixed(1)} ${yI(p.impressions).toFixed(1)}`).join(' ');
    const il = document.createElementNS('http://www.w3.org/2000/svg', 'path'); il.setAttribute('d', iLine); il.setAttribute('class', 'line'); svg.append(il);

    // marginal line (dashed)
    const mLine = pts.map((p: any, i: number) => `${i === 0 ? 'M' : 'L'}${x(p.budget_wan).toFixed(1)} ${yM(p.marginal_impressions_per_wan || 0).toFixed(1)}`).join(' ');
    const ml = document.createElementNS('http://www.w3.org/2000/svg', 'path'); ml.setAttribute('d', mLine); ml.setAttribute('class', 'marginal'); svg.append(ml);

    // dots
    pts.forEach((p: any) => {
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('cx', x(p.budget_wan)); c.setAttribute('cy', yI(p.impressions)); c.setAttribute('r', p.is_current ? 6 : 4);
      c.setAttribute('class', p.is_current ? 'dot dot--now' : 'dot'); svg.append(c);
    });

    // knee marker
    if (elast.knee_budget_wan) {
      const kx = x(elast.knee_budget_wan);
      const k = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      k.setAttribute('x1', kx); k.setAttribute('x2', kx); k.setAttribute('y1', padT); k.setAttribute('y2', padT + ih); k.setAttribute('class', 'knee'); svg.append(k);
    }
    set('[data-k="knee"]', `拐点 ${elast.knee_budget_wan ?? '—'} 万`);

    // 9-budget table
    const rows = document.querySelector('[data-k="elast-rows"]')!;
    rows.replaceChildren();
    pts.forEach((p: any) => {
      const tr = document.createElement('tr');
      const mk = (v: any, className: string) => { const td = document.createElement('td'); td.className = className; td.textContent = v; return td; };
      tr.append(mk(p.budget_wan, 'num'), mk(fmtWan(p.impressions / 10000, 1), 'num'), mk(pctReadable(p.reach), 'num'), mk(fmtWan(p.frequency, 1), 'num'), mk(fmtWan(p.cpm_yuan, 1), 'num'), mk(fmtInt(p.marginal_impressions_per_wan), 'num'));
      rows.append(tr);
    });

    function set(sel: string, v: string) { const el = document.querySelector(sel); if (el) el.textContent = v; }
  }
</script>
